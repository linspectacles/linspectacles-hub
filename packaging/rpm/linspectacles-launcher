#!/bin/sh
# LinSpectacles packaged launcher: immutable Hub application, user-owned runtime state.
export LINSPECTACLES_RUNTIME_KIND=packaged
export LINSPECTACLES_PACKAGE_PROVIDER=RPM
# Backward-compatible provider declaration retained for older Hub runtimes.
export LINSPECTACLES_INSTALL_MODE=rpm
exec /usr/bin/python3 @LIBEXECDIR@/linspectacles/main.py "$@"
